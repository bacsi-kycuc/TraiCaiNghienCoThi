rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Default fallback security gate: Deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global schema and domain-level sanitization helpers
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    
    function incoming(req) { 
      return req.resource.data; 
    }

    // 3. Validation Rules for App Datasets

    // Gigs/Genres Collection
    match /genres/{genreId} {
      allow read: if true;
      allow create, update: if isValidId(genreId)
        && incoming(request).keys().hasAll(['name', 'icon']) 
        && incoming(request).keys().hasOnly(['name', 'icon', 'description'])
        && incoming(request).name is string && incoming(request).name.size() >= 0 && incoming(request).name.size() <= 100
        && incoming(request).icon is string && incoming(request).icon.size() >= 0 && incoming(request).icon.size() <= 20
        && (!incoming(request).keys().hasAny(['description']) || (incoming(request).description is string && incoming(request).description.size() <= 1000));
      allow delete: if true;
    }

    // Prompts Collection
    match /prompts/{promptId} {
      allow read: if true;
      allow create, update: if isValidId(promptId)
        && incoming(request).keys().hasAll(['id', 'title', 'url', 'icon', 'description', 'genre', 'tags', 'zone', 'createdAt', 'updatedAt'])
        && incoming(request).id is int
        && incoming(request).title is string && incoming(request).title.size() > 0 && incoming(request).title.size() <= 255
        && incoming(request).url is string && incoming(request).url.size() >= 0 && incoming(request).url.size() <= 2000
        && incoming(request).icon is string && incoming(request).icon.size() >= 0 && incoming(request).icon.size() <= 20
        && incoming(request).description is string && incoming(request).description.size() >= 0 && incoming(request).description.size() <= 10000
        && incoming(request).genre is string && incoming(request).genre.size() >= 0 && incoming(request).genre.size() <= 100
        && incoming(request).tags is list && incoming(request).tags.size() <= 20
        && (incoming(request).zone == 'hospital' || incoming(request).zone == 'cai-nghien')
        && incoming(request).createdAt is string && incoming(request).createdAt.size() <= 50
        && incoming(request).updatedAt is string && incoming(request).updatedAt.size() <= 50
        && (!incoming(request).keys().hasAny(['password']) || incoming(request).password is string)
        && (!incoming(request).keys().hasAny(['passwordFailLimit']) || incoming(request).passwordFailLimit is int)
        && (!incoming(request).keys().hasAny(['passwordFailGifUrl']) || incoming(request).passwordFailGifUrl is string)
        && (!incoming(request).keys().hasAny(['passwordFailSecondaryHint']) || incoming(request).passwordFailSecondaryHint is string)
        && (!incoming(request).keys().hasAny(['passwordFailSoundUrl']) || incoming(request).passwordFailSoundUrl is string)
        && (!incoming(request).keys().hasAny(['passwordHint']) || incoming(request).passwordHint is string)
        && (!incoming(request).keys().hasAny(['viewCount']) || incoming(request).viewCount is int)
        && (!incoming(request).keys().hasAny(['isGiveaway']) || incoming(request).isGiveaway is bool)
        && (!incoming(request).keys().hasAny(['maxWinners']) || incoming(request).maxWinners is int)
        && (!incoming(request).keys().hasAny(['drawDuration']) || incoming(request).drawDuration is int)
        && (!incoming(request).keys().hasAny(['linkVisibleDuration']) || incoming(request).linkVisibleDuration is int)
        && (!incoming(request).keys().hasAny(['giveawayStartTime']) || incoming(request).giveawayStartTime is string)
        && (!incoming(request).keys().hasAny(['participants']) || incoming(request).participants is list)
        && (!incoming(request).keys().hasAny(['winners']) || incoming(request).winners is list)
        && (!incoming(request).keys().hasAny(['giveawayStatus']) || incoming(request).giveawayStatus is string)
        && (!incoming(request).keys().hasAny(['drawnTime']) || incoming(request).drawnTime is string);
      allow delete: if true;
    }

    // Users Collection (Custom Accounts)
    match /users/{userId} {
      allow read, write: if true;
    }

    // Admission logs/Records Collection
    match /records/{recordId} {
      allow read: if true;
      allow create, update: if isValidId(recordId)
        && incoming(request).keys().hasAll(['id', 'name', 'age', 'genre', 'note', 'symptoms', 'zone', 'date'])
        && incoming(request).keys().size() == 8
        && incoming(request).id is int
        && incoming(request).name is string && incoming(request).name.size() > 0 && incoming(request).name.size() <= 100
        && incoming(request).age is string && incoming(request).age.size() > 0 && incoming(request).age.size() <= 100
        && incoming(request).genre is string && incoming(request).genre.size() > 0 && incoming(request).genre.size() <= 100
        && incoming(request).note is string && incoming(request).note.size() >= 0 && incoming(request).note.size() <= 10000
        && incoming(request).symptoms is list && incoming(request).symptoms.size() <= 20
        && (incoming(request).zone == 'hospital' || incoming(request).zone == 'cai-nghien')
        && incoming(request).date is string && incoming(request).date.size() > 0 && incoming(request).date.size() <= 50;
      allow delete: if true;
    }

    // Dynamic system configurations (Settings)
    match /settings/{settingsId} {
      allow read, write: if isValidId(settingsId);
    }

    // Real-time Votes Collection
    match /votes/{characterId} {
      allow read, write: if true;
    }

    // Quiz Questions Collection
    match /quiz_questions/{questionId} {
      allow read, write: if true;
    }
  }
}
